{
  "name": "kasir-desktop",
  "version": "1.0.0",
  "description": "Aplikasi POS Rumah Makan - kasir desktop",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc",
    "build:renderer": "vite build",
    "build:all": "npm run build && npm run build:renderer && npm run copy:assets",
    "copy:assets": "node scripts/copy-renderer.js",
    "dev:renderer": "vite --config vite.config.ts",
    "dev:main": "tsc && set ELECTRON_DEV=1 && electron dist/main/index.js",
    "rebuild:sqlite": "electron-rebuild -f -w better-sqlite3",
    "start": "npm run build:all && electron dist/main/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@electron/rebuild": "3.6.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "16.18.68",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.2.1",
    "autoprefixer": "10.5.5",
    "electron": "22.3.27",
    "electron-builder": "23.6.0",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "4.9.5",
    "vite": "4.5.14"
  },
  "dependencies": {
    "better-sqlite3": "9.6.0",
    "node-thermal-printer": "^4.6.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.5.7"
  }
}
